{
  "name": "aurasync-core",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "tsx --env-file-if-exists=.env scripts/probe.ts",
    "analyst": "tsx --env-file-if-exists=.env scripts/analyst-run.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server/server.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "baseline": "tsx --env-file-if-exists=.env scripts/baseline.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "version": "0.2.0"
}
