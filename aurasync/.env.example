QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
# Any OpenAI-compatible chat endpoint. Free option: Google AI Studio key (no card), base URL below.
# LLM_MODEL: copy an exact model id from AI Studio's model list (a Flash model). Do not guess.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-flash
PORT=3000
RUNS_PER_IP_HOUR=6
RUNS_PER_DAY=150
MAX_CONCURRENT=2
RUN_TIMEOUT_MS=150000
# Number of reverse proxies in front of this server (Render/Railway/Fly = 1, none/local = 0).
# With N > 0 the client IP is the Nth entry from the right of X-Forwarded-For; the leftmost entries are spoofable.
TRUSTED_PROXY_HOPS=0
# Refuse new runs when Qloo reports fewer than this many calls left this month.
QLOO_MIN_REMAINING=300
# Qloo explainability: verified by probe on 2026-10-28, safe to enable.
QLOO_EXPLAINABILITY=1
